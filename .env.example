# HTTP port the API (and the built SPA) listens on
PORT=3000
# development | production | test
NODE_ENV=development
# Directory containing the built web client; defaults to apps/web/dist/client
# WEB_DIST=
# SQLite file path (used from the persistence phase onward)
DATABASE_URL=./data/intesa.db
# Enables POST /api/auth/dev-login (ignored when NODE_ENV=production)
# DEV_LOGIN=true
# Public origin used for OAuth redirects and the Secure cookie flag
# PUBLIC_URL=http://localhost:3000
# Google sign-in (both required to enable it); redirect URI is <PUBLIC_URL>/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# PostgreSQL instead of SQLite: DATABASE_URL=postgres://user:pass@host:5432/dbname
# Run the API tests against Postgres (uses/overwrites the schema "intesa_test"):
#   TEST_DATABASE_URL=postgres://postgres:intesa@localhost:55432/intesa bun run test:pg
