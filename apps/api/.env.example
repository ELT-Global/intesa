# Server settings. Copy to apps/api/.env (git-ignored). Bun loads that file automatically
# because `bun run dev`, `bun run start` and the tests all run with apps/api as the working
# directory. Variables already set in the shell take precedence over the file.

# HTTP port for the API and the built web client
PORT=3000

# development | production | test. `bun run dev` forces development. When unset the server
# assumes production, which disables the dev login.
# NODE_ENV=production

# SQLite file path, or a postgres:// URL (PostgreSQL: postgres://user:pass@host:5432/dbname).
# Unset: <repo root>/data/intesa.db. A relative path is relative to apps/api.
# DATABASE_URL=

# Directory with the built web client; defaults to apps/web/dist/client
# WEB_DIST=

# Public origin of the app (no trailing slash). Used for the Google redirect URI, and session
# cookies get the Secure flag when NODE_ENV=production and this starts with https://
# PUBLIC_URL=http://localhost:3000

# Google sign-in; both are required to enable it.
# The redirect URI to register is <PUBLIC_URL>/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Enables POST /api/auth/dev-login (ignored when NODE_ENV=production)
# DEV_LOGIN=true

# Run the API tests against Postgres (drops and recreates the schema "intesa_test"):
#   TEST_DATABASE_URL=postgres://postgres:intesa@localhost:55432/intesa bun run test:pg
# TEST_DATABASE_URL=
